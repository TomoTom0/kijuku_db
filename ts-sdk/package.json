{
  "name": "kijuku-db",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "docs/usage/sdk/",
    "examples/"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --external better-sqlite3 --dts && cp -r src/server/static dist/server/ && mkdir -p dist/docs/usage && cp -r ../docs/usage/sdk dist/docs/usage/ && cp -r ../docs/api dist/docs/",
    "deploy:local": "../scripts/dev/deploy-local.sh",
    "build:all": "pnpm run build && pnpm run deploy:local",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e/sdk-remote.test.ts",
    "test:all": "vitest run test/unit test/integration",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts",
    "example:crud": "cd .. && tsx examples/01-basic-crud.ts",
    "example:search": "cd .. && tsx examples/02-search-filter.ts",
    "example:bulk": "cd .. && tsx examples/03-bulk-operations.ts",
    "example:remote": "cd .. && tsx examples/04-remote-operations.ts",
    "benchmark": "tsx benchmarks/performance.bench.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "better-sqlite3": "^11.1.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "hono": "^4.11.1",
    "smol-toml": "^1.6.0",
    "ssh-config": "^5.0.4",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.5",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
